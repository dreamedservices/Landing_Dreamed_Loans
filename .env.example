# Solo servidor: el endpoint de leads valida este destino y lo devuelve tras enviar el correo.
SYSTEM_REGISTER_URL=https://sistema.example.com/auth/register

LEADS_NOTIFICATION_EMAIL=leads@example.com

# Solo servidor. SMTP directo (reemplazó a Gmail API/OAuth — ver LEADS-RUNBOOK.md).
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_DEBUG=0

# Protección y observabilidad opcionales.
LEAD_RATE_LIMIT_SECRET=

# No implementado en Fase 05 (no aprobado todavía). Dejar vacío.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analítica: Google Analytics 4 con banner de consentimiento (decidido en Fase 00).
